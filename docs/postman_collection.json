		{
			"name": "02. Authentication",
			"item": [
				{
					"name": "Login (Admin)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.data && jsonData.data.access_token) {",
									"    pm.collectionVariables.set(\"token\", jsonData.data.access_token);",
									"    pm.environment.set(\"token\", jsonData.data.access_token);",
									"    console.log(\"Saved access_token to variable: \", jsonData.data.access_token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"Password123!\"\n}"
						},
						"url": "{{baseUrl}}/api/v1/auth/login"
					}
				},
				{
					"name": "Get Current User Profile",
					"request": {
						"method": "GET",
						"url": "{{baseUrl}}/api/v1/auth/me"
					}
				},
				{
					"name": "Refresh Token",
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refresh_token\": \"sample_refresh_token_here\"\n}"
						},
						"url": "{{baseUrl}}/api/v1/auth/refresh"
					}
				},
				{
					"name": "Logout",
					"request": {
						"auth": { "type": "noauth" },
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refresh_token\": \"sample_refresh_token_here\"\n}"
						},
						"url": "{{baseUrl}}/api/v1/auth/logout"
					}
				}
			]
